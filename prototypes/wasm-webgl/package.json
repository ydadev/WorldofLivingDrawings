{
  "name": "ldw-risk-01-wasm-webgl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build:wasm": "node ../../tools/build-wasm.mjs",
    "build:fish": "node ../fish-assets/generate.mjs && node generate-paper.mjs && node verify-fish.mjs",
    "build": "npm run build:wasm && npm run build:fish && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
